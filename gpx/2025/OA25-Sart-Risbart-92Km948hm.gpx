  <wpt lat="50.78065" lon="4.65593">
    <name>Rue de Pécrot</name>
    <desc>Rue de Pécrot&lt;p&gt;Beklimmingscode van RouteYou : &lt;a href="//help.routeyou.com/topic/view/640" rel="nofollow" target="_blank"&gt;E_1_c&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Lengte : 0.4 km&lt;/li&gt;&lt;li&gt;Stijging : 36 m&lt;/li&gt;&lt;li&gt;Gemiddelde hellingsgraad : 7 m / 100 m - 6.87 %&lt;/li&gt;&lt;li&gt;Maximale hellingsgraad : 11.7 %&lt;/li&gt;&lt;/ul&gt;&lt;br/&gt;&lt;br/&gt;Auteur: &lt;a href="https://www.routeyou.com/user/view/607725.nl"&gt;Cols&amp;Climbs@RouteYou&lt;/a&gt;&lt;br/&gt;&lt;a href="https://www.routeyou.com/location/view/51146097.nl?toptext=7485292"&gt;Meer informatie&lt;/a&gt;</desc>
    <type>Helling</type>
  </wpt>
