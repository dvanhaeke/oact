    <type>Helling</type>
  </wpt>
  <wpt lat="50.80439" lon="4.65824">
    <name>speelbergstraat</name>
    <desc>speelbergstraat&lt;p&gt;Beklimmingscode van RouteYou : &lt;a href="//help.routeyou.com/topic/view/640" rel="nofollow" target="_blank"&gt;E_2_c&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Lengte : 0.34 km&lt;/li&gt;&lt;li&gt;Stijging : 27 m&lt;/li&gt;&lt;li&gt;Gemiddelde hellingsgraad : 7 m / 100 m - 7.16 %&lt;/li&gt;&lt;li&gt;Maximale hellingsgraad : 13.35 %&lt;/li&gt;&lt;/ul&gt;&lt;br/&gt;&lt;br/&gt;Auteur: &lt;a href="https://www.routeyou.com/user/view/607725.nl"&gt;Cols&amp;Climbs@RouteYou&lt;/a&gt;&lt;br/&gt;&lt;a href="https://www.routeyou.com/location/view/51812477.nl?toptext=8195730"&gt;Meer informatie&lt;/a&gt;</desc>
